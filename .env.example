# Supabase backend — copy this file to .env.local and fill in your values.
# Find both in your Supabase project: Dashboard → Settings → API.
# Without these, the app runs in single-browser demo mode (localStorage).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
